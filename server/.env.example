# ─── Tattva Tech API — environment variables ────────────────────────────────
# Copy to server/.env for local development. On Vercel, set these in
# Project Settings → Environment Variables. Never commit real values.

# Runtime
NODE_ENV=development
PORT=5000

# MongoDB connection string (REQUIRED in production)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tattva_tech_db

# JWT signing secret (REQUIRED in production — admin login is disabled without it).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Admin accounts
# Registration is only open while the database has zero admins. After that,
# a new admin must send this invite code with the registration request.
ADMIN_INVITE_CODE=
# Optional first-run bootstrap: if both are set and no admin exists yet,
# this admin is created on the first login attempt.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# CORS — comma separated list of allowed browser origins ('*' allows all).
# Default when empty: https://tattvatechsolutions.in, https://www.tattvatechsolutions.in,
# http://localhost:5173, http://127.0.0.1:5173. Add Vercel preview URLs here if needed.
CORS_ORIGINS=

# SMTP (email notifications). Without SMTP_USER/SMTP_PASS emails are skipped.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# true for port 465 (implicit TLS); defaults to true only when SMTP_PORT=465
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=app-password-here
# Optional; defaults to SMTP_USER. May be a full "Name <address>" string.
SMTP_FROM=

# Who receives website enquiries and job applications
COMPANY_HEAD_EMAIL=owner@example.com
HR_EMAIL=hr@example.com

# Cloudinary (image + resume uploads from the admin panel / careers form)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional rate-limit overrides (defaults shown)
# RATE_LIMIT_CONTACT_MAX=5
# RATE_LIMIT_CONTACT_WINDOW_MS=600000
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_AUTH_WINDOW_MS=900000
# RATE_LIMIT_APPLICATION_MAX=5
# RATE_LIMIT_APPLICATION_WINDOW_MS=3600000

# Send a short automatic "we received your message" email to form submitters (off by default)
SEND_AUTO_REPLY=false

# Resumes are private (authenticated) by default; set to "upload" for public links
# CLOUDINARY_RESUME_TYPE=authenticated
